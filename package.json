{
  "name": "legalbahi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @wakeel/api run dev",
    "dev:web": "cmd /c \"set NODE_ENV=development&& npm --workspace @wakeel/web run dev\"",
    "dev:mobile": "npm --workspace @wakeel/mobile run dev",
    "restart:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-servers.ps1",
    "lint": "node scripts/lint-repo.mjs",
    "typecheck": "npm run typecheck:api && npm run typecheck:mobile",
    "test": "npm run test:api && npm run test:mobile:flows && npm run test:deployment",
    "test:web": "npm run test:web:e2e",
    "build": "npm run build:web",
    "test:api": "npm --workspace @wakeel/api run test",
    "test:web:e2e": "playwright test",
    "typecheck:api": "npm --workspace @wakeel/api run typecheck",
    "build:web": "npm --workspace @wakeel/web run build",
    "migrate": "npm --workspace @wakeel/api run migrate",
    "smoke:production": "npm --workspace @wakeel/api run smoke:production",
    "test:mobile:flows": "node scripts/verify-mobile-flows.mjs",
    "test:deployment": "node scripts/verify-deployment-assets.mjs",
    "typecheck:mobile": "npm --workspace @wakeel/mobile exec tsc -- --noEmit",
    "verify": "npm run test:api && npm run typecheck:api && npm run build:web && npm run test:web:e2e && npm run typecheck:mobile && npm run test:mobile:flows && npm run test:deployment",
    "reset:demo": "npm --workspace @wakeel/api run reset:demo",
    "vps:sync": "node scripts/vps-sync-config.mjs",
    "vps:sync:api": "node scripts/vps-sync-api.mjs"
  },
  "overrides": {
    "postcss": "8.5.15",
    "uuid": "11.1.1",
    "@babel/core": "^7.29.7",
    "ws": "^8.17.0",
    "js-yaml": "^4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "^4.22.4",
    "typescript": "latest",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "node-ssh": "^13.2.1"
  }
}
