{
  "name": "@wakeel/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "seed:investor": "node --import tsx src/seed-investor-postgres.ts",
    "migrate:seed-r2": "node --import tsx src/migrate-seed-to-r2.ts",
    "worker": "node --import tsx src/worker.ts",
    "start": "node --import tsx src/server.ts",
    "smoke:production": "node --import tsx src/production-smoke.ts",
    "test": "node --import tsx --test ./test/*.test.ts",
    "typecheck": "npx tsc --noEmit",
    "reset:demo": "node --import tsx src/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@fastify/busboy": "^3.2.0",
    "@fastify/cors": "latest",
    "@fastify/multipart": "^10.0.0",
    "@sentry/node": "^10.57.0",
    "@types/sanitize-html": "^2.16.1",
    "@wakeel/shared": "*",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "fastify": "latest",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.15.6"
  }
}
