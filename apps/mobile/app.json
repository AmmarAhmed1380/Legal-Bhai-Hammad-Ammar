{
  "expo": {
    "name": "Legal Bhai",
    "slug": "legalbahi",
    "version": "1.0.0",
    "icon": "./assets/legalbahi-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/legalbahi-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F3"
    },
    "android": {
      "package": "pk.legalbahi.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/legalbahi-adaptive-foreground.png",
        "backgroundColor": "#0F6E56"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-status-bar"
    ]
  }
}
