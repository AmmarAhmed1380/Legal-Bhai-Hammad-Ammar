# Do not set NODE_ENV here — Next.js sets it automatically (development for `next dev`, production for `next build`).
PORT=3001
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Development-only switches. Both must be false in production.
ENABLE_DEMO_SURFACES=false
ENABLE_PRODUCT_SEED_DATA=true
WAKEEL_DEV_OTP_CODE=246810
# Investor staging: production Postgres/R2 with placeholder OTP (no Twilio SMS).
INVESTOR_STAGING=false
IHC_LIVE_FETCH_ENABLED=false
COURT_LIVE_FETCH_ENABLED=false
IHC_SYNC_ENABLED=false
IHC_SYNC_INTERVAL_MINUTES=60

DATABASE_URL=postgresql://legalbahi:replace-me@localhost:5432/legalbahi
TEST_DATABASE_URL=
USE_POSTGRES_PRODUCT_STORE=false
POSTGRES_SSL=false
POSTGRES_POOL_SIZE=10
POSTGRES_STATEMENT_TIMEOUT_MS=10000
PILOT_ADMIN_SECRET=replace-with-random-pilot-admin-secret
# Trust forwarded client IPs only when traffic arrives through loopback Caddy.
TRUST_PROXY_LOOPBACK=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Database backups (worker uploads gzip archives to R2_BACKUP_BUCKET)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_CHECK_INTERVAL_MINUTES=60

# Voice transcription (Phase 4 — optional in development)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
RESEND_API_KEY=
RESEND_FROM_EMAIL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DOCUMENT_BUCKET=legalbahi-private-documents
R2_BACKUP_BUCKET=legalbahi-postgres-backups
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
SENTRY_DSN=

# External uptime monitoring (UptimeRobot, GitHub Actions, etc.)
UPTIME_SECRET=

# Document malware scanning (required in production before uploads reach R2)
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_PROVIDER=clamav
MALWARE_SCAN_TIMEOUT_MS=30000
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLOUDMERSIVE_API_KEY=
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_POLL_TIMEOUT_MS=45000
